    <!-- Add insight / key takeaway directly related to activity / learner experience -->

    <insight>
        <p>
            A geometric sequence is a sequence in which each term is obtained by multiplying the previous term by a constant value called the common ratio.
        </p>
        <p>
            If the first term is <m>a</m> and the common ratio is <m>r</m>, then the <m>n^{\text{th}}</m> term <m>t_n</m> is given by:
        </p>
        <p>
            <m>t_n = ar^{n-1}</m>
        </p>
        <p>
            This formula allows us to determine any term in the sequence without listing all previous terms.
        </p>
    </insight>

    <!-- Add further instruction (not in a block) to develop ideas as needed -->

    <xi:include href="../lesson-plan-templates/example-intro.ptx" />

    <!-- Add at least 3 examples -->

    <example>
        <statement>
            <p>
                The diagram shows a growing pattern of diamond shapes.
            </p>
            <figure xml:id="fig-geom-diamond-example">
                <caption>A growing diamond pattern — Steps 1 to 3.</caption>
                <image width="85%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.65]
                    % Step 1: 1 diamond — teal (odd step)
                    \filldraw[fill=teal!65, draw=black] (0.5,1) -- (1,0.5) -- (0.5,0) -- (0,0.5) -- cycle;
                    % Step 2: 3 diamonds in a row — orange (even step)
                    \foreach \col in {0,1,2} {
                        \filldraw[fill=orange!85!yellow, draw=black] ({3+\col+0.5},1) -- ({3+\col+1},0.5) -- ({3+\col+0.5},0) -- ({3+\col},0.5) -- cycle;
                    }
                    % Step 3: 9 diamonds in a 3x3 grid — teal (odd step)
                    \foreach \row in {0,1,2} {
                        \foreach \col in {0,1,2} {
                            \filldraw[fill=teal!65, draw=black] ({8+\col+0.5},{\row+1}) -- ({8+\col+1},{\row+0.5}) -- ({8+\col+0.5},\row) -- ({8+\col},{\row+0.5}) -- cycle;
                        }
                    }
                    \node[below] at (0.5,-0.2) {\small Step 1};
                    \node[below] at (4.5,-0.2) {\small Step 2};
                    \node[below] at (9.5,-0.2) {\small Step 3};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
            <p>
                <ol marker="(a)">
                    <li><p>Write down the first three terms of the sequence.</p></li>
                    <li><p>What is the common ratio?</p></li>
                    <li><p>Find the number of diamonds at Step 4.</p></li>
                    <li><p>Write a formula for the <m>n^{th}</m> term.</p></li>
                </ol>
            </p>
        </statement>
        <solution>
            <p>
                <ol marker="(a)">
                    <li>
                        <p>
                            Counting the diamonds at each step: <m>1, 3, 9</m>.
                        </p>
                    </li>
                    <li>
                        <p>
                            <md>
                                <mrow>r \amp =\; \frac{3}{1} = \frac{9}{3} = 3</mrow>
                            </md>
                            The common ratio is <m>r = 3</m>.
                        </p>
                    </li>
                    <li>
                        <p>
                            <md>
                                <mrow>\text{Step 4} \amp =\; 1 \times 3^{4-1} = 3^3 = 27 \text{ diamonds}</mrow>
                            </md>
                        </p>
                    </li>
                    <li>
                        <p>
                            With first term <m>a = 1</m> and common ratio <m>r = 3</m>:
                            <md>
                                <mrow>T_n \amp =\; 3^{n-1}</mrow>
                            </md>
                        </p>
                    </li>
                </ol>
            </p>
        </solution>
    </example>

    <example>
        <statement>
            <p>
                The diagram shows a growing pattern of pentagon shapes, doubling at each step.
            </p>
            <figure xml:id="fig-geom-pentagon-example">
                <caption>A doubling pentagon pattern — Steps 1 to 4.</caption>
                <image width="90%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.65]
                    % Step 1: 1 pentagon — purple (odd step)
                    \begin{scope}[shift={(0.5,0.5)}]
                        \filldraw[fill=purple!60!white, draw=black] (90:0.42)--(162:0.42)--(234:0.42)--(306:0.42)--(18:0.42)--cycle;
                    \end{scope}
                    % Step 2: 2 pentagons in a column — lime (even step)
                    \foreach \row in {0,1} {
                        \begin{scope}[shift={(2.5,{\row+0.5})}]
                            \filldraw[fill=lime!65, draw=black] (90:0.42)--(162:0.42)--(234:0.42)--(306:0.42)--(18:0.42)--cycle;
                        \end{scope}
                    }
                    % Step 3: 4 pentagons in 2x2 — purple (odd step)
                    \foreach \row in {0,1} {
                        \foreach \col in {0,1} {
                            \begin{scope}[shift={({5+\col+0.5},{\row+0.5})}]
                                \filldraw[fill=purple!60!white, draw=black] (90:0.42)--(162:0.42)--(234:0.42)--(306:0.42)--(18:0.42)--cycle;
                            \end{scope}
                        }
                    }
                    % Step 4: 8 pentagons in 2x4 — lime (even step)
                    \foreach \row in {0,...,3} {
                        \foreach \col in {0,1} {
                            \begin{scope}[shift={({8+\col+0.5},{\row+0.5})}]
                                \filldraw[fill=lime!65, draw=black] (90:0.42)--(162:0.42)--(234:0.42)--(306:0.42)--(18:0.42)--cycle;
                            \end{scope}
                        }
                    }
                    \node[below] at (0.5,-0.2) {\small Step 1};
                    \node[below] at (2.5,-0.2) {\small Step 2};
                    \node[below] at (6.0,-0.2) {\small Step 3};
                    \node[below] at (9.0,-0.2) {\small Step 4};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
            <p>
                <ol marker="(a)">
                    <li><p>Write down the sequence formed and state the common ratio.</p></li>
                    <li><p>Find the number of pentagons at Step 6.</p></li>
                    <li><p>At which step will there first be more than 100 pentagons?</p></li>
                </ol>
            </p>
        </statement>
        <solution>
            <p>
                <ol marker="(a)">
                    <li>
                        <p>
                            The sequence is <m>1, 2, 4, 8, \ldots</m> with common ratio <m>r = 2</m>.
                        </p>
                    </li>
                    <li>
                        <p>
                            <md>
                                <mrow>T_6 \amp =\; 1 \times 2^{6-1} = 2^5 = 32 \text{ pentagons}</mrow>
                            </md>
                        </p>
                    </li>
                    <li>
                        <p>
                            We need <m>2^{n-1} &gt; 100</m>.
                            <md>
                                <mrow>2^6 \amp =\; 64 &lt; 100</mrow>
                                <mrow>2^7 \amp =\; 128 &gt; 100</mrow>
                            </md>
                            So <m>n - 1 = 7</m>, meaning Step <m>8</m> is the first step with more than 100 pentagons.
                        </p>
                    </li>
                </ol>
            </p>
        </solution>
    </example>

    <example>
        <statement>
            <p>
                Given the geometric sequence <m>4,12,36,...</m>, find the <m>4^{th}, 5^{th},</m> and <m>n^{th} </m> terms.
            </p>
        </statement>
        <solution>
            <p>
                <md>
                    <mrow> \text{The first term,}\; a =  \amp \; 4 </mrow>
                    <mrow> \text{The common ratio,}\; r \amp = \; 3 </mrow>
                    <mrow> \therefore \;\text{the}\; 4^{th}\; \text{term}\; \amp = \; 4\times 3^{4-1} </mrow>
                    <mrow> \amp = \; 4 \times 3^3 </mrow>
                    <mrow> \amp = \; 108 </mrow>
                    <mrow> \text{The}\; 5^{th} \; \text{term}\; \amp = \; 4 \times 3^{5-1} </mrow>
                    <mrow> \amp = \; 4 \times 3^4 </mrow>
                    <mrow> \amp = \; 324 </mrow>
                    <mrow> \text{The}\; n^{th} \; \text{term}\; \amp = \; 4 \times 3^{n-1} </mrow>
                </md>
                
            </p>
        </solution>
    </example>
    <example>
        <statement>
            <p>
                The <m>4^{th}</m> term of a geometric sequence is <m>16</m>. If the first term is <m>2</m>, find:
            </p>
            <p>
                <ol marker="(a)">
                    <li>
                        <p>
                            The common ratio.
                        </p>
                    </li>
                    <li>
                        <p>
                            The seventh term.
                        </p>
                    </li>
                </ol>
            </p>
        </statement>
        <solution>
            <p>
                <ol marker="(a)">
                    <li>
                    <p>
                        The common ratio <m>r</m>.
                    </p>
                        <p>
                            <md>
                                <mrow> \text{The first term,} \; a \amp = \; 2 </mrow>
                                <mrow> \text{The}4^{th}\; \text{ term is}\; 2\times r^{4-1} \amp = \; 16 </mrow>
                                <mrow>\text{Thus,} \; 2r^3 \amp = \; 16 </mrow>
                                <mrow> r^3 \amp = \; 8 </mrow>
                                <mrow> \therefore \;\text{the common ratio} \; \amp = \; 2 </mrow>
                            </md>
                        </p>
                    </li>
                    <li>
                    <p>
                        The <m>7^{th}</m> term.
                    </p>
                        <p>
                            <md>
                                <mrow>\text{The}\; 7^{th}\; \text{term} \; \amp = \; 2 \times 2^6 </mrow>
                                <mrow> \amp = \; 128 </mrow>
                            </md>
                            
                        </p>
                    </li>
                </ol>
            </p>
        </solution>
    </example>
    <example>
        <statement>
            <p>
                The fourth term of a geometric sequence is <m>8</m> and the sixth term is <m>32</m>. Find the two possible common ratios.
            </p>
        </statement>
        <solution>
            <p>
                <md>
                    <mrow>\text{The}\; 4^{th} \;\text{term is} \; ar^3 \amp = \; 8 </mrow>
                    <mrow>\text{The}\; 6^{th} \;\text{term is} \; ar^5 \amp = \; 32 </mrow>
                    <mrow>\therefore \frac{ar^5}{ar^3} \amp = \; \frac{32}{8} </mrow>
                    <mrow> r^2 \amp = \; 4</mrow>
                    <mrow> r \amp = \; \pm 2 </mrow>
                </md>
            </p>
            <p>
                The possible common ratios are <m>r = 2</m> and <m>r = -2</m>.
            </p>
        </solution>
    </example>

    <xi:include href="../lesson-plan-templates/assessment-intro.ptx" />

    <!-- If STACK questions are included, uncomment this: -->

    <!-- <xi:include href="../lesson-plan-templates/checkpoint.ptx" /> -->

    <!-- Add STACK exercises if made -->

    <!-- Add static exercises -->
    <exercises>
        <exercise>
            <statement>
                <p>
                    The ratio of the <m>10^{th}</m> to the <m>8^{th}</m> terms of a geometric sequence is <m>9</m>. Find the two possible common ratios.
                </p>
            </statement>
            <answer>
                <p>
                    <m>\pm3</m>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    The third term of a geometric sequence is <m>1</m>. If the sixth term of the same sequence is <m>\frac{1}{27}</m>, write down the first four terms of the sequence.
                </p>
            </statement>
            <answer>
                <p>
                    <m>9,3,1,\frac{1}{3}</m>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    The ratio of the forth to the first term of a geometric sequence is <m>\frac{1}{8}</m>. If the first term exceeds the second term by <m>5</m>, find the first and the <m>8^{th}</m> terms of the sequence.
                </p>
            </statement>
            <answer>
                <p>
                    <m>10, \frac{5}{64}</m>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    The first, third, and fifth terms of a geometric sequence form arithmetic sequence. If the first term of the sequence is <m>3</m>, find the tenth term of the geometric sequence.
                </p>
            </statement>
            <answer>
                <p>
                    <m>\pm3</m>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    The first term of a geometric sequence is <m>x+1</m>. if the third term of the same sequence is <m>(x+1)(x^2 - 2x +1)</m>, show that the second term is <m>x^2 -1</m>.
                </p>
            </statement>
            <answer>
                <p>
                    <md>
                        <mrow> \frac{\text{Third term}}{\text{first term}}  =\amp \; \frac{(x+1)(x^2-2x+1)}{x+1} </mrow>
                        <mrow>\frac{ar^2}{a} \amp = \; \frac{(x+1)(x^2-2x+1)}{x+1} </mrow>
                        <mrow> r^2 \amp = \; x^2-2x+1 </mrow>
                        <mrow> r \amp = \; x-1 </mrow>
                        <mrow> \text{The second term} \; \amp = \; ar </mrow>
                        <mrow>2^{nd} \;\text{term}\; \amp = \; (x+1)(x-1) </mrow>
                        <mrow>2^{nd} \;\text{term}\; \amp = \; (x^2-1) </mrow>
                    </md>
                    
                </p>
                <p>
                    The second term of the geometric sequence is <m>x^2 - 1</m>.
                </p>
            </answer>
        </exercise>

        <exercise>
            <introduction>
                <p>
                    The following pattern shows circles arranged in growing grids.
                </p>
                <figure xml:id="fig-geom-circle-pattern">
                    <caption>A growing circle pattern — Steps 1 to 3.</caption>
                    <image width="85%">
                        <latex-image>
                        \begin{tikzpicture}[scale=0.65]
                        % Step 1: 1 circle — cyan (odd step)
                        \filldraw[fill=cyan!65, draw=black] (0.5,0.5) circle (0.42);
                        % Step 2: 3 circles in a row — magenta (even step)
                        \foreach \col in {0,1,2} {
                            \filldraw[fill=magenta!55, draw=black] ({3+\col+0.5},0.5) circle (0.42);
                        }
                        % Step 3: 9 circles in a 3x3 grid — cyan (odd step)
                        \foreach \row in {0,1,2} {
                            \foreach \col in {0,1,2} {
                                \filldraw[fill=cyan!65, draw=black] ({8+\col+0.5},{\row+0.5}) circle (0.42);
                            }
                        }
                        \node[below] at (0.5,-0.2) {\small Step 1};
                        \node[below] at (4.5,-0.2) {\small Step 2};
                        \node[below] at (9.5,-0.2) {\small Step 3};
                        \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
            </introduction>
            <task>
                <statement>
                    <p>
                        Count the circles at each step and write down the first three terms of the sequence.
                        What is the common ratio <m>r</m>?
                    </p>
                </statement>
                <answer>
                    <p>
                        The sequence is <m>1, 3, 9, \ldots</m> with common ratio <m>r = 3</m>.
                    </p>
                </answer>
                <solution>
                    <p>
                        <md>
                            <mrow>\text{Step 1} \amp =\; 1</mrow>
                            <mrow>\text{Step 2} \amp =\; 3</mrow>
                            <mrow>\text{Step 3} \amp =\; 9 = 3^2</mrow>
                        </md>
                        Each step has three times as many circles as the one before, so <m>r = 3</m>.
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        Write a formula for <m>T_n</m>, the number of circles at Step <m>n</m>.
                    </p>
                </statement>
                <answer>
                    <p>
                        <m>T_n = 3^{n-1}</m>
                    </p>
                </answer>
                <solution>
                    <p>
                        With first term <m>a = 1</m> and common ratio <m>r = 3</m>:
                        <md>
                            <mrow>T_n \amp =\; a \cdot r^{n-1} = 1 \times 3^{n-1} = 3^{n-1}</mrow>
                        </md>
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        How many circles are at Step 5?
                        At which step are there 729 circles?
                    </p>
                </statement>
                <answer>
                    <p>
                        Step 5 has <m>81</m> circles. There are 729 circles at Step 7.
                    </p>
                </answer>
                <solution>
                    <p>
                        <md>
                            <mrow>T_5 \amp =\; 3^4 = 81</mrow>
                        </md>
                        For 729 circles: <m>3^{n-1} = 729 = 3^6</m>, so <m>n - 1 = 6</m> and <m>n = 7</m>.
                    </p>
                </solution>
            </task>
        </exercise>

        <exercise>
            <introduction>
                <p>
                    The following pattern shows hexagons arranged in growing clusters.
                </p>
                <figure xml:id="fig-geom-hexagon-pattern">
                    <caption>A growing hexagon pattern — Steps 1 to 4.</caption>
                    <image width="90%">
                        <latex-image>
                        \begin{tikzpicture}[scale=0.65]
                        % Step 1: 1 hexagon — blue (odd step)
                        \begin{scope}[shift={(0.5,0.5)}]
                            \filldraw[fill=blue!55!white, draw=black] (0:0.45)--(60:0.45)--(120:0.45)--(180:0.45)--(240:0.45)--(300:0.45)--cycle;
                        \end{scope}
                        % Step 2: 2 hexagons in a row — red (even step)
                        \foreach \col in {0,1} {
                            \begin{scope}[shift={({3+\col+0.5},0.5)}]
                                \filldraw[fill=red!60!white, draw=black] (0:0.45)--(60:0.45)--(120:0.45)--(180:0.45)--(240:0.45)--(300:0.45)--cycle;
                            \end{scope}
                        }
                        % Step 3: 4 hexagons in 2x2 — blue (odd step)
                        \foreach \row in {0,1} {
                            \foreach \col in {0,1} {
                                \begin{scope}[shift={({6+\col+0.5},{\row+0.5})}]
                                    \filldraw[fill=blue!55!white, draw=black] (0:0.45)--(60:0.45)--(120:0.45)--(180:0.45)--(240:0.45)--(300:0.45)--cycle;
                                \end{scope}
                            }
                        }
                        % Step 4: 8 hexagons in 2x4 — red (even step)
                        \foreach \row in {0,...,3} {
                            \foreach \col in {0,1} {
                                \begin{scope}[shift={({9+\col+0.5},{\row+0.5})}]
                                    \filldraw[fill=red!60!white, draw=black] (0:0.45)--(60:0.45)--(120:0.45)--(180:0.45)--(240:0.45)--(300:0.45)--cycle;
                                \end{scope}
                            }
                        }
                        \node[below] at (0.5,-0.2) {\small Step 1};
                        \node[below] at (4.0,-0.2) {\small Step 2};
                        \node[below] at (7.0,-0.2) {\small Step 3};
                        \node[below] at (10.0,-0.2) {\small Step 4};
                        \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
            </introduction>
            <task>
                <statement>
                    <p>
                        Count the hexagons at each step. Write down the sequence and state the common ratio.
                    </p>
                </statement>
                <answer>
                    <p>
                        The sequence is <m>1, 2, 4, 8, \ldots</m> with common ratio <m>r = 2</m>.
                    </p>
                </answer>
                <solution>
                    <p>
                        <md>
                            <mrow>\text{Step 1} \amp =\; 1, \quad \text{Step 2} = 2, \quad \text{Step 3} = 4, \quad \text{Step 4} = 8</mrow>
                        </md>
                        Each step doubles the number of hexagons, so <m>r = 2</m>.
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        Write a formula for <m>T_n</m>, the number of hexagons at Step <m>n</m>.
                    </p>
                </statement>
                <answer>
                    <p>
                        <m>T_n = 2^{n-1}</m>
                    </p>
                </answer>
                <solution>
                    <p>
                        With <m>a = 1</m> and <m>r = 2</m>:
                        <md>
                            <mrow>T_n = 2^{n-1}</mrow>
                        </md>
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        At which step will there first be <m>32</m> hexagons?
                    </p>
                </statement>
                <answer>
                    <p>
                        Step 6.
                    </p>
                </answer>
                <solution>
                    <p>
                        Solve <m>2^{n-1} = 32 = 2^5</m>, so <m>n - 1 = 5</m> and <m>n = 6</m>.
                    </p>
                </solution>
            </task>
        </exercise>

        <exercise>
            <introduction>
                <p>
                    The following pattern shows triangles arranged in growing grids.
                </p>
                <figure xml:id="fig-geom-triangle-pattern">
                    <caption>A growing triangle pattern — Steps 1 to 4.</caption>
                    <image width="90%">
                        <latex-image>
                        \begin{tikzpicture}[scale=0.65]
                        % Step 1: 1 triangle — green (odd step)
                        \filldraw[fill=green!55, draw=black] (0.5,0.9) -- (0.05,0.05) -- (0.95,0.05) -- cycle;
                        % Step 2: 2 triangles in a row — violet (even step)
                        \foreach \col in {0,1} {
                            \filldraw[fill=violet!60, draw=black] ({3+\col+0.5},0.9) -- ({3+\col+0.05},0.05) -- ({3+\col+0.95},0.05) -- cycle;
                        }
                        % Step 3: 4 triangles in 2x2 — green (odd step)
                        \foreach \row in {0,1} {
                            \foreach \col in {0,1} {
                                \filldraw[fill=green!55, draw=black] ({6+\col+0.5},{\row+0.9}) -- ({6+\col+0.05},{\row+0.05}) -- ({6+\col+0.95},{\row+0.05}) -- cycle;
                            }
                        }
                        % Step 4: 8 triangles in 2x4 — violet (even step)
                        \foreach \row in {0,...,3} {
                            \foreach \col in {0,1} {
                                \filldraw[fill=violet!60, draw=black] ({9+\col+0.5},{\row+0.9}) -- ({9+\col+0.05},{\row+0.05}) -- ({9+\col+0.95},{\row+0.05}) -- cycle;
                            }
                        }
                        \node[below] at (0.5,-0.2) {\small Step 1};
                        \node[below] at (4.0,-0.2) {\small Step 2};
                        \node[below] at (7.0,-0.2) {\small Step 3};
                        \node[below] at (10.0,-0.2) {\small Step 4};
                        \end{tikzpicture}
                        </latex-image>
                    </image>
                </figure>
            </introduction>
            <task>
                <statement>
                    <p>
                        Count the triangles at each step. Write down the sequence and state the common ratio.
                    </p>
                </statement>
                <answer>
                    <p>
                        The sequence is <m>1, 2, 4, 8, \ldots</m> with common ratio <m>r = 2</m>.
                    </p>
                </answer>
                <solution>
                    <p>
                        <md>
                            <mrow>\text{Step 1} \amp =\; 1, \quad \text{Step 2} = 2, \quad \text{Step 3} = 4, \quad \text{Step 4} = 8</mrow>
                        </md>
                        Each step doubles the previous count, so <m>r = 2</m>.
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        The first term is <m>a = 1</m>. Write a formula for <m>T_n</m>.
                    </p>
                </statement>
                <answer>
                    <p>
                        <m>T_n = 2^{n-1}</m>
                    </p>
                </answer>
                <solution>
                    <p>
                        <md>
                            <mrow>T_n = a \cdot r^{n-1} = 1 \times 2^{n-1} = 2^{n-1}</mrow>
                        </md>
                    </p>
                </solution>
            </task>
            <task>
                <statement>
                    <p>
                        At which step will there be <m>128</m> triangles?
                    </p>
                </statement>
                <answer>
                    <p>
                        Step 8.
                    </p>
                </answer>
                <solution>
                    <p>
                        Solve <m>2^{n-1} = 128 = 2^7</m>, so <m>n - 1 = 7</m> and <m>n = 8</m>.
                    </p>
                </solution>
            </task>
        </exercise>
    </exercises>

