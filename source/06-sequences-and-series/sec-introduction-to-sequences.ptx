    <!-- Add Activity -->
    <activity>
        <introduction>
            <p>
                <term>Visual Patterns — Work in Groups</term>
            </p>
            <p>
                The diagrams below show sequences of tile arrangements.
                For each pattern:
            </p>
            <p>
                <ul>
                    <li><p>Count the number of tiles at each step and record your results in a table.</p></li>
                    <li><p>Describe the rule connecting one step to the next.</p></li>
                    <li><p>Predict the number of tiles at Step 5.</p></li>
                    <li><p>Write a formula for the number of tiles at Step <m>n</m>.</p></li>
                </ul>
            </p>
        </introduction>

        <task>
            <title>Pattern A</title>
            <figure xml:id="fig-seq-staircase-pattern">
                <caption>Staircase pattern — Steps 1 to 4.</caption>
                <image width="90%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.65]
                    % Step 1 (1 tile) — teal (odd steps)
                    \filldraw[fill=teal!65, draw=black] (0,0) rectangle ++(1,1);
                    % Step 2 (3 tiles) — orange (even steps)
                    \foreach \x/\y in {2/0, 3/0, 2/1} {
                        \filldraw[fill=orange!85!yellow, draw=black] (\x,\y) rectangle ++(1,1);
                    }
                    % Step 3 (6 tiles) — teal (odd steps)
                    \foreach \x/\y in {5/0, 6/0, 7/0, 5/1, 6/1, 5/2} {
                        \filldraw[fill=teal!65, draw=black] (\x,\y) rectangle ++(1,1);
                    }
                    % Step 4 (10 tiles) — orange (even steps)
                    \foreach \x/\y in {9/0, 10/0, 11/0, 12/0, 9/1, 10/1, 11/1, 9/2, 10/2, 9/3} {
                        \filldraw[fill=orange!85!yellow, draw=black] (\x,\y) rectangle ++(1,1);
                    }
                    \node[below] at (0.5,-0.2) {\small Step 1};
                    \node[below] at (3.0,-0.2) {\small Step 2};
                    \node[below] at (6.5,-0.2) {\small Step 3};
                    \node[below] at (11.0,-0.2) {\small Step 4};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
        </task>

        <task>
            <title>Pattern B</title>
            <figure xml:id="fig-seq-cross-pattern">
                <caption>Cross pattern — Steps 1 to 4.</caption>
                <image width="90%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.5]
                    % All crosses vertically centered: center square at y=3 for all steps.
                    % Step 1 (1 tile) — blue (odd steps): single square at (0,3)
                    \filldraw[fill=blue!55!white, draw=black] (0,3) rectangle ++(1,1);
                    % Step 2 (5 tiles) — red (even steps): center=(3,3), arm=1
                    \foreach \x/\y in {2/3, 3/3, 4/3, 3/2, 3/4} {
                        \filldraw[fill=red!60!white, draw=black] (\x,\y) rectangle ++(1,1);
                    }
                    % Step 3 (9 tiles) — blue (odd steps): center=(8,3), arm=2
                    \foreach \x/\y in {6/3, 7/3, 8/3, 9/3, 10/3, 8/1, 8/2, 8/4, 8/5} {
                        \filldraw[fill=blue!55!white, draw=black] (\x,\y) rectangle ++(1,1);
                    }
                    % Step 4 (13 tiles) — red (even steps): center=(15,3), arm=3
                    \foreach \x/\y in {12/3, 13/3, 14/3, 15/3, 16/3, 17/3, 18/3, 15/0, 15/1, 15/2, 15/4, 15/5, 15/6} {
                        \filldraw[fill=red!60!white, draw=black] (\x,\y) rectangle ++(1,1);
                    }
                    % Labels sit below each step's lowest tile
                    \node[below] at (0.5,3.0) {\small Step 1};
                    \node[below] at (3.5,2.0) {\small Step 2};
                    \node[below] at (8.5,1.0) {\small Step 3};
                    \node[below] at (15.5,0.0) {\small Step 4};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
        </task>

        <task>
            <title>Pattern C</title>
            <figure xml:id="fig-seq-rectangle-pattern">
                <caption>Rectangle pattern — Steps 1 to 4.</caption>
                <image width="90%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.55]
                    % Step 1: 1 row x 2 cols (2 tiles) — green (odd steps)
                    \foreach \col in {0,1} {
                        \filldraw[fill=green!55, draw=black] (\col,0) rectangle ++(1,1);
                    }
                    % Step 2: 2 rows x 3 cols (6 tiles) — violet (even steps)
                    \foreach \row in {0,1} {
                        \foreach \col in {0,1,2} {
                            \filldraw[fill=violet!60, draw=black] ({3+\col},\row) rectangle ++(1,1);
                        }
                    }
                    % Step 3: 3 rows x 4 cols (12 tiles) — green (odd steps)
                    \foreach \row in {0,1,2} {
                        \foreach \col in {0,1,2,3} {
                            \filldraw[fill=green!55, draw=black] ({7+\col},\row) rectangle ++(1,1);
                        }
                    }
                    % Step 4: 4 rows x 5 cols (20 tiles) — violet (even steps)
                    \foreach \row in {0,1,2,3} {
                        \foreach \col in {0,1,2,3,4} {
                            \filldraw[fill=violet!60, draw=black] ({12+\col},\row) rectangle ++(1,1);
                        }
                    }
                    \node[below] at (1.0,-0.2) {\small Step 1};
                    \node[below] at (4.5,-0.2) {\small Step 2};
                    \node[below] at (9.0,-0.2) {\small Step 3};
                    \node[below] at (14.5,-0.2) {\small Step 4};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
        </task>

        <task>
            <title>Pattern D</title>
            <figure xml:id="fig-seq-doubling-pattern">
                <caption>Doubling pattern — Steps 1 to 4.</caption>
                <image width="90%">
                    <latex-image>
                    \begin{tikzpicture}[scale=0.65]
                    % Step 1: 1x1 (1 tile) — cyan (odd steps)
                    \filldraw[fill=cyan!65, draw=black] (0,0) rectangle ++(1,1);
                    % Step 2: 1x2 (2 tiles) — magenta (even steps)
                    \foreach \col in {0,1} {
                        \filldraw[fill=magenta!55, draw=black] ({2+\col},0) rectangle ++(1,1);
                    }
                    % Step 3: 2x2 (4 tiles) — cyan (odd steps)
                    \foreach \row in {0,1} {
                        \foreach \col in {0,1} {
                            \filldraw[fill=cyan!65, draw=black] ({5+\col},\row) rectangle ++(1,1);
                        }
                    }
                    % Step 4: 2x4 (8 tiles) — magenta (even steps)
                    \foreach \row in {0,1} {
                        \foreach \col in {0,1,2,3} {
                            \filldraw[fill=magenta!55, draw=black] ({8+\col},\row) rectangle ++(1,1);
                        }
                    }
                    \node[below] at (0.5,-0.2) {\small Step 1};
                    \node[below] at (3.0,-0.2) {\small Step 2};
                    \node[below] at (6.0,-0.2) {\small Step 3};
                    \node[below] at (10.0,-0.2) {\small Step 4};
                    \end{tikzpicture}
                    </latex-image>
                </image>
            </figure>
        </task>

        <conclusion>
            <p>
                Share your findings with another group.
                Which pattern was most surprising?
                Can you describe what kind of sequence (arithmetic, geometric, or other) each pattern produces?
            </p>
        </conclusion>
    </activity>

     <p>
        Look around your school, rows of desks, steps on a staircase, days in a timetable. Many things in life follow an order.
     </p>


