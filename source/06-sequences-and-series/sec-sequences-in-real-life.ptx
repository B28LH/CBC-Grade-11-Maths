    <!-- If STACK questions are included, uncomment this: -->

    <!-- <xi:include href="../lesson-plan-templates/checkpoint.ptx" /> -->

    <!-- Add STACK exercises if made -->
    <exercises>
        <exercise>
            <statement>
                <p>
                    The school library charges a fine of Ksh <m>0.50</m> on day <m>1</m> for an overdue book. Each day the fine increases by Ksh <m>0.20</m>.
                </p>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                How much will the fine be on day <m>10</m>?
                            </p>
                        </li>
                        <li>
                            <p>
                                What is the total fine if the book is returned <m>10</m> days later?
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                Ksh <m>2.30</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                Ksh <m>14</m>
                            </p>
                        </li>
                    </ol>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    A school starts a science club with <m>6</m> members. Each month, the number of new members is <m>3</m> times that of the previous month. 
                </p>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                How many new members join in month <m>5</m>?
                            </p>
                        </li>
                        <li>
                            <p>
                                What is the total number of members after <m>5</m> months?
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>
            <answer>
                <p>
                    <ol marker="(a)">
                        <li>
                            <p>
                                <m>486</m> members
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>726</m> members
                            </p>
                        </li>
                    </ol>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                   A student plans to study <m>30</m> minutes on day <m>1</m> and increase by <m>5</m> minutes each day. What is the total study time after <m>12</m> days?
                </p>
            </statement>
            <answer>
                <p>
                    <m>11 \;\text{hours}\; 30 \; \text{minutes} </m>
                </p>
            </answer>
        </exercise>
    </exercises>

