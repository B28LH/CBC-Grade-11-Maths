    <insight>
        <p>
            Approximation is widely used in real life to simplify measurements, but every approximation introduces an error. 
        </p>
        <p>
            The size of the error depends on the method and level of accuracy used. 
        </p>
        <p>
            Smaller errors give more reliable results, which is why accuracy is important in fields like engineering, science, banking, and construction.
        </p>
    </insight>

    <!-- Add further instruction (not in a block) to develop ideas as needed -->

    <xi:include href="../lesson-plan-templates/example-intro.ptx" />
    <example>
        <statement>
            <p>
                A tailor measures a piece of cloth as <m>2.486 \text{ m}</m>. The value is recorded to the nearest <m>0.1 \text{ m}</m>.
            </p>

            <p>
                Determine:
            </p>
            <p>
                <ol marker="(a)">
                    <li>
                        <p>
                            The rounded value.
                        </p>
                    </li>
                    <li>
                        <p>
                            The absolute error.
                        </p>
                    </li>
                </ol>
            </p>
        </statement>

        <solution>
            <p>
                Rounded value: <m>2.5 \text{ m}</m>
            </p>
            <p>
                <md>
                    \text{Absolute Error} = |2.486 - 2.5| = 0.014 \text{ m}
                </md>
            </p>
        </solution>
    </example>
    <example>
        <statement>
            <p>
                A bank rounds a transaction amount of <m>1584.72</m> to the nearest shilling.
            </p>

            <p>
                Find the rounded value and absolute error.
            </p>
        </statement>

        <solution>
            <p>
                Rounded value: <m>1585</m>
            </p>

            <p>
                <md>
                    \text{Absolute Error} = |1584.72 - 1585| = 0.28
                </md>
            </p>
        </solution>
    </example>
    <example>
        <statement>
            <p>
                A student measures the length of a table as <m>1.734 \text{ m}</m>
                and records it to <m>2</m> decimal places.
            </p>

            <p>
                Determine the recorded value and absolute error.
            </p>
        </statement>

        <solution>
            <p>
                Recorded value: <m>1.73 \text{ m}</m>
            </p>

            <p>
                <md>
                    \text{Absolute Error} = |1.734 - 1.73| = 0.004 \text{ m}
                </md>
            </p>
        </solution>
    </example>
    <example>
        <statement>
            <p>
                A cyclist records a distance of <m>9.876 \text{ km}</m>
                but truncates it to <m>2</m> decimal places.
            </p>

            <p>
                Find the truncated value and absolute error.
            </p>
        </statement>

        <solution>
            <p>
                Truncated value: <m>9.87 \text{ km}</m>
            </p>

            <p>
                <md>
                    \text{Absolute Error} = |9.876 - 9.87| = 0.006 \text{ km}
                </md>
            </p>    
        </solution>
    </example>

    <xi:include href="../lesson-plan-templates/assessment-intro.ptx" />

    <!-- If STACK questions are included, uncomment this: -->

    <!-- <xi:include href="../lesson-plan-templates/checkpoint.ptx" /> -->

    <!-- Add STACK exercises if made -->

    <exercises>
        <exercise>
            <statement>
                <p>
                    A student measures a length as <m>5.678 \text{ cm}</m>.
                    It is recorded to the nearest <m>0.1 \text{ cm}</m>.
                </p>

                <p>
                    Find:
                </p>

                <ol marker="(a)">
                    <li>the recorded value,</li>
                    <li>the absolute error.</li>
                </ol>
            </statement>

            <answer>
                <p>
                    Recorded value: <m>5.7 \text{ cm}</m>
                </p>
                <p>
                    <md>
                        \text{Absolute Error} = |5.678 - 5.7| = 0.022 \text{ cm}
                    </md>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    A shop records the mass of sugar as <m>2.456 \text{ kg}</m>
                    but rounds it to <m>2.5 \text{ kg}</m>.
                </p>

                <p>
                    Find the absolute error.
                </p>
            </statement>

            <answer>
                <p>
                    <md>
                        \text{Absolute Error} = |2.456 - 2.5| = 0.044 \text{ kg}
                    </md>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    A distance is measured as <m>18.349 \text{ km}</m> but truncated to <m>2</m> decimal places.
                </p>

                <p>
                    Find the truncated value and absolute error.
                </p>
            </statement>

            <answer>
                <p>
                    Truncated value: <m>18.34 \text{ km}</m>
                </p>
                <p>
                    <md>
                        \text{Absolute Error} = |18.349 - 18.34| = 0.009 \text{ km}
                    </md>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    A thermometer reads <m>36.784^\circ \text{C}</m>.
                    It is rounded to <m>2</m> decimal places.
                </p>

                <p>
                    Find the rounded value and absolute error.
                </p>
            </statement>

            <answer>
                <p>
                    Rounded value: <m>36.78^\circ \text{C}</m>
                </p>
                <p>
                    <md>
                        \text{Absolute Error} = |36.784 - 36.78| = 0.004^\circ \text{C}
                    </md>
                </p>
            </answer>
        </exercise>
        <exercise>
            <statement>
                <p>
                    A farmer records the length of a field as <m>123.56 \text{ m}</m>
                    and truncates it to <m>3</m> significant figures.
                </p>

                <p>
                    Find the truncated value and absolute error.
                </p>
            </statement>

            <answer>
                <p>
                    Truncated value: <m>123 \text{ m}</m>
                </p>
                <p>
                    <md>
                        \text{Absolute Error} = |123.56 - 123| = 0.56 \text{ m}
                    </md>
                </p>
            </answer>
        </exercise>

    </exercises>

