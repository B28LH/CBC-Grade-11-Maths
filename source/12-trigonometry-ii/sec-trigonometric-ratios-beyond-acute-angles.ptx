<?xml version="1.0" encoding="utf-8"?>

<section xml:id="sec-trigonometric-ratios-beyond-acute-angles" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Trigonometric Ratios Beyond Acute Angles</title>
    <objectives component="outcomes">
        <introduction>
            <p>
            <dl>
                <li>
                    <title>Strand</title>
                    <p>
                        2.0 Measurement and Geometry
                    </p>
                </li>
                <li>
                    <title>Sub-Strand</title>
                    <p>
                        2.5 Trigonometry II
                    </p>
                </li>
                <li>
                    <title>Specific Learning Outcomes</title>
                    <p>
                        Determine trigonometric ratios of angles greater than 90 degrees in different situations
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Grade Level</title>
                    <p>
                        11
                    </p>
                </li>
                <li component="lesson-plan">
                    <title>Estimated Duration</title>
                    <p>
                        40 minutes
                    </p>
                </li>
            </dl>
            </p>
        </introduction>
    </objectives>

    <!-- [LP] Add guidance on activity -->

    <activity>
        <title>Magic Unit Circle</title>
        <introduction>
            <p>
                Work in groups to explore how trigonometric ratios change for angles greater than 90 degrees using a unit circle.
            </p>
            <p>
                Each group will create a unit circle on manila paper, label quadrants, and place angle values in the correct region. Then compare the signs and values of sine, cosine and tangent as the angle moves through each quadrant.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    Draw a unit circle on manila paper and mark the four quadrants clearly with different colours.
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    Write different angle measures on sticky notes, including acute, obtuse, and reflex angles.
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    Place each sticky note on the quadrant where the angle ends on the unit circle. Be ready to explain your choice.
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    Discuss how the signs of sin, cos and tan change in each quadrant, and how the unit circle helps determine those signs for angles beyond 90 degrees.
                </p>
            </statement>
        </task>
    </activity>

    <!-- [LP] Add guidance on structured lesson plan -->

    <insight>
        <title>Key Takeaway</title>
        <p>
            The unit circle shows that sine and cosine for angles beyond 90 degrees depend on the quadrant, while tangent depends on both sine and cosine signs.
        </p>
        <p>
            Understanding quadrant signs helps learners determine trigonometric ratios for obtuse and reflex angles without memorising each value separately.
        </p>
    </insight>

    <xi:include href="../lesson-plan-templates/example-intro.ptx" />

    <!-- Add at least 3 examples -->

    <example>
        <statement>
            <p>
                Find the sine, cosine, and tangent of <m>120^\circ</m>.
            </p>
        </statement>
        <solution>
            <p> 
               Since <m>120^\circ</m> is between <m>90^\circ</m> and <m>180^\circ</m>, it lies in the second quadrant. 
            </p>
            <p>
                <ul>
                    <li>
                        <p>
                            Therefore the sine of <m>120^\circ</m> is positive, and can be calculated as:
                            <md>
                                <m>\sin 120^\circ = \sin(180^\circ - 60^\circ) = \sin 60^\circ = \frac{\sqrt{3}}{2}</m>
                            </md>
                        </p>
                    </li>
                </ul>
            </p>
        </solution>
    </example>

    <example>
        <statement>
            <p>
                A radar antenna rotates through <m>225^\circ</m> from its starting position. Determine the exact values of <m>\sin 225^\circ</m> and <m>\cos 225^\circ</m>.
         </p>
        </statement>
        <solution>
            <p>
                Since <m>225^\circ</m> is in the third quadrant, both sine and cosine are negative.
            </p>
            <p>
                <md>
                    <m>\sin 225^\circ = -\frac{\sqrt{2}}{2}</m>
                </md>
            </p>
            <p>
                <md>
                    <m>\cos 225^\circ = -\frac{\sqrt{2}}{2}</m>
                </md>
            </p>
        </solution>
    </example>

    <example>
        <statement>
            <p>
                A point on the unit circle corresponds to an angle of <m>300^\circ</m>. 
            </p>
            <p>
                Find:
                <ol>
                    <li>
                        <p>
                            The coordinates of the point on the unit circle corresponding to an angle of <m>300^\circ</m>.
                        </p>
                    </li>
                    <li>
                        <p>
                            The sine, cosine, and tangent of <m>300^\circ</m>.
                        </p>
                    </li>
                </ul>
            </p>
        </statement>
        <solution>
            <p>
            <ol>
                <li>
                    <p>
                        The coordinates of the point on the unit circle corresponding to an angle of <m>300^\circ</m> are <m>\left(\frac{1}{2}, -\frac{\sqrt{3}}{2}\right)</m>.
                    </p>
                    
                </li>
                <li>
                     <p> 
                        Therefore, we can determine the sine, cosine, and tangent as follows:
                            <m>\sin 300^\circ = -\frac{\sqrt{3}}{2}</m>
                        </p>
                    </li>
                    <li>
                        <p>
                            <m>\cos 300^\circ = \frac{1}{2}</m>
                        </p>
                    </li>
                    <li>
                        <p>
                            <m>\tan 300^\circ = \frac{\sin 300^\circ}{\cos 300^\circ} = -\sqrt{3}</m>
                        </p>
                    </li>
                </ol>
            </p>
        </solution>
    </example> 

    <xi:include href="../lesson-plan-templates/assessment-intro.ptx" />

    <!-- If STACK questions are included, uncomment this: -->

    <!-- <xi:include href="../lesson-plan-templates/checkpoint.ptx" /> -->

    <!-- Add STACK exercises if made -->

    <!-- Add static exercises -->

    <exercises>
        <exercise>
            <statement>   
                <p>
                    Given an angle of <m>150^\circ</m>, determine:
                </p>
                <p>
                    <ol>
                        <li>
                            <p>
                                sine
                            </p>
                        </li>
                        <li>
                            <p>
                               cosine 
                            </p>
                        </li>
                        <li>
                            <p>
                               tangent 
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>   
            <solution>
              <p>
                <ol>
                    <li>
                        <p>
                            The sine of <m>150^\circ</m> is <m>\frac{1}{2}</m>.
                        </p>
                    </li>
                    <li>
                        <p>
                            The cosine of <m>150^\circ</m> is <m>-\frac{\sqrt{3}}{2}</m>.
                        </p>
                    </li>
                    <li>
                        <p>
                            The tangent of <m>150^\circ</m> is <m>-\frac{1}{\sqrt{3}}</m>.
                        </p>
                    </li>
                </ol>
              </p>
            </solution>                   
        </exercise>
        <exercise>
            <statement>
                <p>
                    A point on the unit circle corresponds to an angle of <m>210^\circ</m>. 
                </p>
                <p>
                    Find:
                    <ol>
                        <li>
                            <p>
                                The coordinates of the point on the unit circle corresponding to an angle of <m>210^\circ</m>.
                            </p>
                        </li>
                        <li>
                            <p>
                                The sine.
                            </p>
                        </li>
                        <li>
                            <p>
                                The cosine.
                            </p>
                        </li>
                        <li>
                            <p>
                                The tangent.
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>
            <solution>
                <p>
                    The coordinates of the point on the unit circle corresponding to an angle of <m>210^\circ</m> are <m>\left(-\frac{\sqrt{3}}{2}, -\frac{1}{2}\right)</m>.
                </p>
                <p> 
                    Therefore, we can determine the sine, cosine, and tangent as follows:
                    <ol>
                        <li>
                            <p>
                                The sine of <m>210^\circ</m> is <m>-\frac{1}{2}</m>.
                            </p>
                        </li>
                        <li>
                            <p>
                                The cosine of <m>210^\circ</m> is <m>-\frac{\sqrt{3}}{2}</m>.
                            </p>
                        </li>
                        <li>
                            <p>
                                The tangent of <m>210^\circ</m> is <m>\frac{\sin 210^\circ}{\cos 210^\circ} = \frac{1}{\sqrt{3}}</m>.
                            </p>
                        </li>
                    </ol>
                </p>
            </solution>
        </exercise>
        <exercise>
            <statement>
                <p>
                    If <m>\theta = 330^\circ</m>, and <m>\sin \theta = -\frac{1}{2}</m>, determine:
                </p>
                <p>
                    <ol>
                        <li>
                            <p>
                                cosine of <m>\theta</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                tangent of <m>\theta</m>
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>   
            <solution>
              <p>
                <ol>
                    <li>
                        <p>
                            The sine of <m>330^\circ</m> is <m>-\frac{1}{2}</m>.
                        </p>
                    </li>
                    <li>
                        <p>
                            The cosine of <m>330^\circ</m> is <m>\frac{\sqrt{3}}{2}</m>.
                        </p>
                    </li>
                </ol>
              </p>
            </solution>
        </exercise> 
        <exercise>
            <statement>
                <p>
                    A point on the unit circle corresponds to an angle of <m>140^\circ</m>. 
                </p>
                <p>
                    Find:
                    <ul>
                        <li>
                            <p>
                                The coordinates of the point on the unit circle corresponding to an angle of <m>140^\circ</m>.
                            </p>
                        </li>
                        <li>
                            <p>
                                The sine, cosine, and tangent of <m>140^\circ</m>.
                            </p>
                        </li>
                    </ul>
                </p>
            </statement>   
            <solution>
              <p>
                The coordinates of the point on the unit circle corresponding to an angle of <m>140^\circ</m> are <m>\left(-\frac{\sqrt{3}}{2}, \frac{1}{2}\right)</m>.
              </p>
              <p> 
                    Therefore, we can determine the sine, cosine, and tangent as follows:
                    <ul>
                        <li>
                            <p>
                                The sine of <m>140^\circ</m> is <m>\frac{1}{2}</m>.
                            </p>
                        </li>
                        <li>
                            <p>
                                The cosine of <m>140^\circ</m> is <m>-\frac{\sqrt{3}}{2}</m>.
                            </p>
                        </li>
                        <li>
                            <p>
                                The tangent of <m>140^\circ</m> is <m>\frac{\sin 140^\circ}{\cos 140^\circ} = -\frac{1}{\sqrt{3}}</m>.
                            </p>
                        </li>
                    </ul>
                </p>
            </solution>
        </exercise>       
    </exercises> 

