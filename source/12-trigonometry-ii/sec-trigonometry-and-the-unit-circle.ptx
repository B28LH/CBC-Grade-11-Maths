    <!-- If STACK questions are included, uncomment this: -->

    <!-- <xi:include href="../lesson-plan-templates/checkpoint.ptx" /> -->

    <!-- Add STACK exercises if made -->

    <!-- Add static exercises -->

    <exercises>
        <exercise>
            <statement>   
             <p>
                Determine the coordinates of the point on the unit circle corresponding to an angle of <m>210°</m>.
             </p>
            </statement>   
            <solution>
                <p>
                    The coordinates of the point on the unit circle corresponding to an angle of <m>210°</m> are <m>\left(-\frac{\sqrt{3}}{2}, -\frac{1}{2}\right)</m>.
                </p>
            </solution>             
        </exercise>
        <exercise>
            <statement>   
             <p>
                Determine the quadrant in which an angle of <m>-20°</m> lies.
             </p>
            </statement>   
            <solution>
                <p>
                    An angle of <m>-20°</m> lies in quadrant IV.
                </p>
                </solution>
        </exercise>
        <exercise>
            <statement>   
             <p>
                Determine the value of <m>\tan(150°)</m> using the unit circle.
             </p>
            </statement>   
            <solution>
                   <p>
                      The value of <m>\tan(150°)</m> is <m>\tan(150°)= \frac{\sin(150°)}{\cos(150°)}= \frac{\frac{1}{2}}{-\frac{\sqrt{3}}{2}}= -\frac{1}{\sqrt{3}}</m>.
                   </p>
          </solution>
        </exercise> 
        <exercise>
            <statement>
                <p>
                    Determine the angles between <m>0°</m> and <m>360°</m> that satisfy the equation <m>\cos(\theta)= -\frac{1}{2}</m>.
                </p>
            </statement>
            <solution>
                <p>
                    The angles between <m>0°</m> and <m>360°</m> that satisfy the equation <m>\cos(\theta)= -\frac{1}{2}</m> are <m>\theta= 120°</m> and <m>\theta= 240°</m>.
                </p>
            </solution>
        </exercise>       
    </exercises>

