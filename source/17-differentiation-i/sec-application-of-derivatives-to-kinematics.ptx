    <!-- Add static exercises -->

    <exercises>
        <exercise xml:id="PRECALC-bYXSenbKBa" original="PRECALC/modules/m49455/index.cnxml" license="CC-BY-4.0">
            <title>Try It</title>
            <statement>
                <p>A fireworks rocket is shot upward out of a pit 12 m below the ground at a velocity of 60 m/s. Its height in meters after <m>t</m> seconds is given by <m>s=-16t^{2}+60t-12.</m> What is its instantaneous velocity after 4 seconds?</p>
            </statement>
            <solution>
                <p>-68 m/sec, it is dropping back to Earth at a rate of 68 m/s.</p>
            </solution>
            </exercise>      
        <exercise xml:id="PRECALC-LAPPE9aTlC" original="PRECALC/modules/m49455/index.cnxml" license="CC-BY-4.0">
      <title>Try It</title>
      <statement>
        <p>A runner runs along a straight east-west road. The function <m>f(t)</m> gives how many meters eastward of her starting point she is after <m>t</m> seconds. Interpret each of the following as it relates to the runner.</p>
        <ol marker="(a)">
          <li>
            <m>f(0)=0</m>
          </li>
          <li>
            <m>f(10)=150</m>
          </li>
          <li>
            <m>f'(10)=15</m>
          </li>
          <li>
            <m>f'(20)=-10</m>
          </li>
          <li>
            <m>f(40)=-100</m>
          </li>
        </ol>
      </statement>
      <solution>
        <ol marker="(a)">
          <li>After zero seconds, she has traveled 0 meters.</li>
          <li>After 10 seconds, she has traveled 150 meters east.</li>
          <li>After 10 seconds, she is moving eastward at a rate of 15 m/sec.</li>
          <li>After 20 seconds, she is moving westward at a rate of 10 m/sec.</li>
          <li>After 40 seconds, she is 100 meters westward of her starting point.</li>
        </ol>
      </solution>
    </exercise>
    </exercises>

