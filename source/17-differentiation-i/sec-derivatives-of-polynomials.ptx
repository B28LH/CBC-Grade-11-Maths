    <exercises>
        <exercise xml:id="PRECALC-XQH7bs526U" original="PRECALC/modules/m49455/index.cnxml" license="CC-BY-4.0">
            <statement>
                <p>Find the derivative of the function <m>f(x)=3x^{2}+7x</m> at <m>x=a.</m>
                </p>
            </statement>
            <answer>
                <p>
                <m>f^'(a)=6a+7</m>
                </p>
            </answer>
            </exercise>     
    </exercises>

