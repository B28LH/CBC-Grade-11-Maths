    <exercises>
        <exercisegroup>
        
            <introduction>
                <p>
                    For the following exercises, explain the functions in words.
                </p>
            </introduction>

        <exercise xml:id="PRECALC-a3QqmwCR3N-parts" original="PRECALC/modules/m49455/index.cnxml" license="CC-BY-4.0">
            <p>The volume <m>f(t)</m> of a tank of petrol, in litres, <m>t</m> minutes after noon.</p>
          <statement>
            <ol marker="(a)" cols="2">
              <li>
                <m>f(0)=600</m>
              </li>
              <li>
                <m>f'(30)=-20</m>
              </li>
              <li>
                <m>f(30)=0</m>
              </li>
              <li>
                <m>f'(200)=30</m>
              </li>
              <li>
                <m>f(240)=500</m>
              </li>
            </ol>
          </statement>
          <answer>
            <ol marker="(a)" cols="2">
              <li/>
              <li>At 12:30 <em>p.m.</em>, the rate of change of the number of litres in the tank is -20 litres per minute. That is, the tank is losing 20 litres per minute.</li>
              <li/>
              <li>At 200 minutes after noon, the volume of litres in the tank is changing at the rate of 30 litres per minute.</li>
              <li/>
            </ol>
          </answer>
        </exercise>   
        <exercise>
            <p>The height, <m>s,</m> of a projectile after <m>t</m> seconds is given by <m>s(t)=-16t^{2}+80t.</m>
          </p>
            <statement>
            <ol marker="(a)" cols="2">
              <li>
                <m>s(2)=96</m>
              </li>
              <li>
                <m>s'(2)=16</m>
              </li>
              <li>
                <m>s(3)=96</m>
              </li>
              <li>
                <m>s'(3)=-16</m>
              </li>
              <li>
                <m>s(0)=0,s(5)=0.</m>
              </li>
            </ol>
          </statement>
          <answer>
            <ol marker="(a)" cols="2">
              <li>The height of the projectile after 2 seconds is 96 feet.</li>
              <li/>
              <li>The height of the projectile at <m>t=3</m> seconds is 96 feet.</li>
              <li/>
              <li>The height of the projectile is zero at <m>t=0</m> and again at <m>t=5.</m> In other words, the projectile starts on the ground and falls to earth again after 5 seconds.</li>
            </ol>
          </answer>
        </exercise>
        </exercisegroup>
        <exercise xml:id="PRECALC-dwNOf3OzQ8-parts" original="PRECALC/modules/m49455/index.cnxml" license="CC-BY-4.0">
          <statement>
            <p>The volume <m>V</m> of a sphere with respect to its radius <m>r</m> is given by <m>V=\frac{4}{3}\pi r^{3}</m></p>
            <ol marker="(a)" cols="2">
              <li>Find the average rate of change of <m>V</m> as <m>r</m> changes from 1 cm to 2 cm.</li>
              <li>Find the instantaneous rate of change of <m>V</m> when <m>r=3\text{ cm }\text{ . }</m>
              </li>
            </ol>
          </statement>
          <solution>
            <ol marker="(a)" cols="2">
              <li/>
              <li>
                <m>36 \pi</m>
              </li>
            </ol>
          </solution>
        </exercise>
    </exercises>

