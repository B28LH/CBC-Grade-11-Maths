    <!-- Add static exercises -->

    <exercises>
        <exercise xml:id="PRECALC-PQwP0tBbbH-parts" original="PRECALC/modules/m49455/index.cnxml" license="CC-BY-4.0">
            <p>For the following functions, find the equation of the tangent line to the curve at the given point <m>x</m> on the curve.</p>
          <statement>
            <ol marker="(a)" cols="2">
              <li>
                <m>f(x)=2x^{2}</m> at  <m>x=3</m>
              </li>
              <li>
                <m>f(x)=x^{3}+1</m> at  <m>x=2</m>
              </li>
            </ol>
          </statement>
          <answer>
            <ol marker="(a)" cols="2">
              <li>
                <m>y=9x-27</m>
              </li>
              <li>
                <m>y=12x-15</m>
              </li>
            </ol>
          </answer>
        </exercise>
        <exercise xml:id="PRECALC-qX7bAUDySo" original="PRECALC/modules/m49455/index.cnxml" license="CC-BY-4.0">
            <p>Find <m>k</m> such that the given line is tangent to the graph of the function.</p>
          <statement>
            <p>
              <m>f(x)=x^{2}-kx</m>, line <m>y=4x-9</m>
            </p>
          </statement>
          <answer>
            <p>
              <m>k=-10</m> or <m>k=2</m>
            </p>
          </answer>
        </exercise>
        <exercise xml:id="PRECALC-PczzgI2SHj" original="PRECALC/modules/m49455/index.cnxml" license="CC-BY-4.0">
            <statement>
                <p>Find the equation of a tangent line to the curve of the function <m>f(x)=5x^{2}-x+4</m> at <m>x=2.</m>
                </p>
            </statement>
            <answer>
                <p>
                <m>y=19x-16</m>
                </p>
            </answer>
        </exercise>
    </exercises>

